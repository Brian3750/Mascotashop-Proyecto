# Configuración Core de Supabase (Frontend - Vite)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Configuración Core de Supabase (Backend Server)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# URL Base de la API del Backend (Express)
VITE_API_URL=http://localhost:3000

# CONFIGURACIÓN DE CORREO (NODEMAILER)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email_user@gmail.com
SMTP_PASS=your_app_password_here

# Variable para identificar tu correo de cliente en las pruebas del CRM
CLIENT_TEST_EMAIL=your_test_email@gmail.com